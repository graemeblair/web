isturbs you very much when people talk about you</w:t></w:r></w:p><w:p><w:r><w:t>I don't know [DO NOT READ]</w:t></w:r></w:p><w:p><w:r><w:t>Refused [DO NOT READ]</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p /><w:p><w:r><w:rPr><w:b /><w:b-cs /><w:sz w:val="24" /><w:sz-cs w:val="24" /></w:rPr><w:t xml:space="preserve">Self efficacy </w:t></w:r></w:p><w:p /><w:tbl><w:tblPr><w:tblStyle w:val="TableGrid" /><w:tblW w:w="0" w:type="auto" /><w:tblLook w:val="01E0" /></w:tblPr><w:tblGrid><w:gridCol w:w="1548" /><w:gridCol w:w="3600" /><w:gridCol w:w="3374" /></w:tblGrid><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /><w:shd w:val="clear" w:color="auto" w:fill="000000" /></w:tcPr><w:p><w:pPr><w:bidi w:val="off" /><w:rPr><w:color w:val="FFFFFF" /></w:rPr></w:pPr><w:r><w:rPr><w:color w:val="FFFFFF" /></w:rPr><w:t>Question ID</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /><w:shd w:val="clear" w:color="auto" w:fill="000000" /></w:tcPr><w:p><w:pPr><w:bidi w:val="off" /><w:rPr><w:color w:val="FFFFFF" /></w:rPr></w:pPr><w:r><w:rPr><w:color w:val="FFFFFF" /></w:rPr><w:t>Question</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /><w:shd w:val="clear" w:color="auto" w:fill="000000" /></w:tcPr><w:p><w:pPr><w:bidi w:val="off" /><w:rPr><w:color w:val="FFFFFF" /></w:rPr></w:pPr><w:r><w:rPr><w:color w:val="FFFFFF" /></w:rPr><w:t>Answer</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>685</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">Do you think you can manage to solve difficult problems if you try hard enough?</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>You can always solve difficult problems</w:t></w:r></w:p><w:p><w:r><w:t>You can often solve them</w:t></w:r></w:p><w:p><w:r><w:t>You can sometimes solve them</w:t></w:r></w:p><w:p><w:r><w:t>You can almost never solve
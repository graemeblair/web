ff" /><w:rPr><w:color w:val="FFFFFF" /></w:rPr></w:pPr><w:r><w:rPr><w:color w:val="FFFFFF" /></w:rPr><w:t>Answer</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>583</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">Now I want you to imagine that I'm a relation of yours who has been living outside of Nigeria for many years. I have come to visit Nigeria, and because I don't live in Nigeria anymore I have some questions about all Nigerians--that is, questions about the whole of Nigeria, from East to West, West to South, South to North. Think about all Nigerian people, not just people in this area.</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t /></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>584</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">How many Nigerian people report corruption when they see it?</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>Few Nigerian people report corruption</w:t></w:r></w:p><w:p><w:r><w:t>Some Nigerian people</w:t></w:r></w:p><w:p><w:r><w:t>Plenty of Nigerian people</w:t></w:r></w:p><w:p><w:r><w:t>Almost all Nigerian people report corruption</w:t></w:r></w:p><w:p><w:r><w:t>I don't know [DO NOT READ]</w:t></w:r></w:p><w:p><w:r><w:t>Refused  [DO NOT READ]</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>585</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">In the future, like years after now, do you think that more Nigerian people will report corruption when they see it?</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>Many more Nigerian people will report corruption when they see it</w:t></w:r></w:p><w:p><w:r><w:t>Some more Nigerian people</w:t></w:r></w:p><w:p><w:r><w:t>The same number of Nigerian people</w:t></w:r></w:p><w:p><w:r><w:t>Fewer Nigerian people will report corruption when they see it</w:t></w:r></w:p><w:p><w:r><w:t>I don't know [DO NOT READ]</w:t></w:r></w:p><w:p><w:r><w:t>Refused  [DO NOT READ]</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p /><w:p><w:r><w:rPr><w:b /><w:b-cs /><w:sz w:val="24" /><w:sz-cs w:val="24" /></w:rPr><w:t xml:space="preserve">Personal attitudes toward corruption </w:t></w:r></w:p><w:p /><w:tbl><w:tblPr><w:tblStyle w:val="TableGrid" /><w:tblW w:w="0" w:type="auto" /><w:tblLook w:val="01E0" /></w:tblPr><w:tblGrid><w:gridCol w:w="1548" /><w:gridCol w:w="3600" /><w:gridCol w:w="3374" /></w:tblGrid><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /><w:shd w:val="clear" w:color="auto" w:fill="000000" /></w:tcPr><w:p><w:pPr><w:bidi w:val="off" /><w:rPr><w:color w:val="FFFFFF" /></w:rPr></w:pPr><w:r><w:rPr><w:color w:val="FFFFFF" /></w:rPr><w:t>Question ID</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /><w:shd w:val="clear" w:color="auto" w:fill="000000" /></w:tcPr><w:p><w:pPr><w:bidi w:val="off" /><w:rPr><w:color w:val="FFFFFF" /></w:rPr></w:pPr><w:r><w:rPr><w:color w:val="FFFFFF" /></w:rPr><w:t>Question</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /><w:shd w:val="clear" w:color="auto" w:fill="000000" /></w:tcPr><w:p><w:pPr><w:bidi w:val="off" /><w:rPr><w:color w:val="FFFFFF" /></w:rPr></w:pPr><w:r><w:rPr><w:color w:val="FFFFFF" /></w:rPr><w:t>Answer</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>586</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">Thank you. Now I’d like to know about your own personal thoughts about corruption. We ask these questions because sometimes people have similar tho
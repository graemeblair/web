</w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">The Nigerian films that you watch, do they show problems that happen in your life?</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>Yes, they show lots of problems that happen in your life</w:t></w:r></w:p><w:p><w:r><w:t>Yes, but only some problems</w:t></w:r></w:p><w:p><w:r><w:t>No, they don't show problems</w:t></w:r></w:p><w:p><w:r><w:t>You don't watch Nigerian films [DO NOT READ]</w:t></w:r></w:p><w:p><w:r><w:t>I don't know [DO NOT READ]</w:t></w:r></w:p><w:p><w:r><w:t>Refused [DO NOT READ]</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>541</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">What kinds of problems do you see happen in Nigerian films that you also see in your life?</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>Problems with family</w:t></w:r></w:p><w:p><w:r><w:t>Problems with marriage or love</w:t></w:r></w:p><w:p><w:r><w:t>Problems with money</w:t></w:r></w:p><w:p><w:r><w:t>Problems with corruption</w:t></w:r></w:p><w:p><w:r><w:t>Problems with crime</w:t></w:r></w:p><w:p><w:r><w:t>Jealousy</w:t></w:r></w:p><w:p><w:r><w:t>Other problems [READ ALOUD]</w:t></w:r></w:p><w:p><w:r><w:t>I don't know [DO NOT READ]</w:t></w:r></w:p><w:p><w:r><w:t>Refused [DO NOT READ]</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>542</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">How often do you watch foreign films?</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>Daily (3 times or more per week)</w:t></w:r></w:p><w:p><w:r><w:t>Weekly (1-2 times per week)</w:t></w:r></w:p><w:p><w:r><w:t>Monthly</w:t></w:r></w:p><w:p><w:r><w:t>Yearly</w:t></w:r></w:p><w:p><w:r><w:t>Never</w:t></w:r></w:p><w:p><w:r><w:t>I don't know [DO NOT READ]</w:t></w:r></w:p><w:p><w:r><w:t>Refused [DO NOT READ]</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p /><w:p><w:r><w:rPr><w:b /><w:b-cs /><w:sz w:val="24" /><w:sz-cs w:val="24" /></w:rPr><w:t xml:space="preserve">PHONE USAGE </w:t></w:r></w:p><w:p /><w:tbl><w:tblPr><w:tblStyle w:val="TableGrid" /><w:tblW w:w="0" w:type="auto" /><w:tblLook w:val="01E0" /></w:tblPr><w:tblGrid><w:gridCol w:w="1548" /><w:gridCol w:w="3600" /><w:gridCol w:w="3374" /></w:tblGrid><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /><w:shd w:val="clear" w:color="auto" w:fill="000000" /></w:tcPr><w:p><w:pPr><w:bidi w:val="off" /><w:rPr><w:color w:val="FFFFFF" /></w:rPr></w:pPr><w:r><w:rPr><w:color w:val="FFFFFF" /></w:rPr><w:t>Question ID</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /><w:shd w:val="clear" w:color="auto" w:fill="000000" /></w:tcPr><w:p><w:pPr><w:bidi w:val="off" /><w:rPr><w:color w:val="FFFFFF" /></w:rPr></w:pPr><w:r><w:rPr><w:color w:val="FFFFFF" /></w:rPr><w:t>Question</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /><w:shd w:val="clear" w:color="auto" w:fill="000000" /></w:tcPr><w:p><w:pPr><w:bidi w:val="off" /><w:rPr><w:color w:val="FFFFFF" /></w:rPr></w:pPr><w:r><w:rPr><w:color w:val="FFFFFF" /></w:rPr><w:t>Answer</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>543</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">Now I’m going to ask you some questions about mobile phones and phone networks in your area.</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t /></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>544</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">Do you ever use a mobile phone?</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>Yes</w:t></w:r></w:p><w:p><w:r><w:t>No</w:t></w:r></w:p><w:p><w:r><w:t>I don't know [DO NOT READ]</w:t></w:r></w:p><w:p><w:r><w:t>Refused [DO NOT READ]</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>545</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">Have you used your mobile phone in the last week?</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>Yes</w:t></w:r></w:p><w:p><w:r><w:t>No</w:t></w:r></w:p><w:p><w:r><w:t>I don't know [DO NOT READ]</w:t></w:r></w:p><w:p><w:r><w:t>Refused [DO NOT READ]</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>546</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">How often do you normally receive a text message on that phone?</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>Almost never</w:t></w:r></w:p><w:p><w:r><w:t>About once per week</w:t></w:r></w:p><w:p><w:r><w:t>About once per day</w:t></w:r></w:p><w:p><w:r><w:t>About 2-3 times per day</w:t></w:r></w:p><w:p><w:r><w:t>About 4 or more times per day</w:t></w:r></w:p><w:p><w:r><w:t>I don't know [DO NOT READ]</w:t></w:r></w:p><w:p><w:r><w:t>Refused [DO NOT READ]</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>547</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">Which mobile phone networks do you use regularly?</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>Airtel</w:t></w:r></w:p><w:p><w:r><w:t>Etisalat</w:t></w:r></w:p><w:p><w:r><w:t>Glo</w:t></w:r></w:p><w:p><w:r><w:t>MTN</w:t></w:r></w:p><w:p><w:r><w:t>Visafone</w:t></w:r></w:p><w:p><w:r><w:t>Other [DO NOT READ]</w:t></w:r></w:p><w:p><w:r><w:t>I don't know [DO NOT READ]</w:t></w:r></w:p><w:p><w:r><w:t>Refused [DO NOT READ]</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>548</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">How good is the MTN phone service for sending text messages in this area?</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>Very good, you can send text messages almost all of time</w:t></w:r></w:p><w:p><w:r><w:t>Good, you can send text messages most of the time</w:t></w:r></w:p><w:p><w:r><w:t>Weak, you can send text messages some of the time</w:t></w:r></w:p><w:p><w:r><w:t>Very bad, you can send text messages almost never</w:t></w:r></w:p><w:p><w:r><w:t>I don't know [DO NOT READ]</w:t></w:r></w:p><w:p><w:r><w:t>Refused [DO NOT READ]</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>549</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">How often do you use the internet?</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>Daily (3 times or more per week)</w:t></w:r></w:p><w:p><w:r><w:t>Weekly (1-2 times per week)</w:t></w:r></w:p><w:p><w:r><w:t>Monthly</w:t></w:r></w:p><w:p><w:r><w:t>Yearly</w:t></w:r></w:p><w:p><w:r><w:t>Never</w:t></w:r></w:p><w:p><w:r><w:t>I don't know [DO NOT READ]</w:t></w:r></w:p><w:p><w:r><w:t>Refused [DO NOT READ]</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>550</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">Do you regularly use the internet on your phone?</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>Yes</w:t></w:r></w:p><w:p><w:r><w:t>No</w:t></w:r></w:p><w:p><w:r><w:t>I don't know [DO NOT READ]</w:t></w:r></w:p><w:p><w:r><w:t>Refused [DO NOT READ]</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p /><w:p><w:r><w:rPr><w:b /><w:b-cs /><w:sz w:val="24" /><w:sz-cs w:val="24" /></w:rPr><w:t xml:space="preserve">GENERAL PERSONAL BELIEFS ABOUT CORRUPTION </w:t></w:r></w:p><w:p /><w:tbl><w:tblPr><w:tblStyle w:val="TableGrid" /><w:tblW w:w="0" w:type="auto" /><w:tblLook w:val="01E0" /></w:tblPr><w:tblGrid><w:gridCol w:w="1548" /><w:gridCol w:w="3600" /><w:gridCol w:w="3374" /></w:tblGrid><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /><w:shd w:val="clear" w:color="auto" w:fill="000000" /></w:tcPr><w:p><w:pPr><w:bidi w:val="off" /><w:rPr><w:color w:val="FFFFFF" /></w:rPr></w:pPr><w:r><w:rPr><w:color w:val="FFFFFF" /></w:rPr><w:t>Question ID</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /><w:shd w:val="clear" w:color="auto" w:fill="000000" /></w:tcPr><w:p><w:pPr><w:bidi w:val="off" /><w:rPr><w:color w:val="FFFFFF" /></w:rPr></w:pPr><w:r><w:rPr><w:color w:val="FFFFFF" /></w:rPr><w:t>Question</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /><w:shd w:val="clear" w:color="auto" w:fill="000000" /></w:tcPr><w:p><w:pPr><w:bidi w:val="off" /><w:rPr><w:color w:val="FFFFFF" /></w:rPr></w:pPr><w:r><w:rPr><w:color w:val="FFFFFF" /></w:rPr><w:t>Answer</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>551</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">Now I’m going to ask you some questions about corruption in your area and the country. The information you give me is for this study only and not for any other thing. Please feel free with me.</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t /></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>552</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">Some people say that corruption is harmful for the country, and other people say it can be helpful for the country to keep things running smoothly.  What do you think?</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>Corruption is harmful</w:t></w:r></w:p><w:p><w:r><w:t>Corruption is helpful</w:t></w:r></w:p><w:p><w:r><w:t>Corruption is both harmful and helpful</w:t></w:r></w:p><w:p><w:r><w:t>I don't know [DO NOT READ]</w:t></w:r></w:p><w:p><w:r><w:t>Refused [DO NOT READ]</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>553</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">What are some of the ways that corruption can be harmful to you or to the country?</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>It keeps you poor</w:t></w:r></w:p><w:p><w:r><w:t>It keeps your community poor or less developed</w:t></w:r></w:p><w:p><w:r><w:t>It can be dangerous or lead to violence</w:t></w:r></w:p><w:p><w:r><w:t>It corrupts your politicians or elections</w:t></w:r></w:p><w:p><w:r><w:t>It is not harmful</w:t></w:r></w:p><w:p><w:r><w:t>Other [PLEASE SPECIFY]:</w:t></w:r></w:p><w:p><w:r><w:t>I don't know [DO NOT READ]</w:t></w:r></w:p><w:p><w:r><w:t>Refused [DO NOT READ]</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>554</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">What are some of the ways that corruption can be helpful to you or to the country?</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>It helps you to get services</w:t></w:r></w:p><w:p><w:r><w:t>It can help you to get out of trouble</w:t></w:r></w:p><w:p><w:r><w:t>It is the way things work here</w:t></w:r></w:p><w:p><w:r><w:t>It helps your ethnic or regional group</w:t></w:r></w:p><w:p><w:r><w:t>It is not helpful</w:t></w:r></w:p><w:p><w:r><w:t>Other [PLEASE SPECIFY]:</w:t></w:r></w:p><w:p><w:r><w:t>I don't know [DO NOT READ]</w:t></w:r></w:p><w:p><w:r><w:t>Refused [DO NOT READ]</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p /><w:p><w:r><w:rPr><w:b /><w:b-cs /><w:sz w:val="24" /><w:sz-cs w:val="24" /></w:rPr><w:t xml:space="preserve">Block 1 : Norms for your area </w:t></w:r></w:p><w:p /><w:tbl><w:tblPr><w:tblStyle w:val="TableGrid" /><w:tblW w:w="0" w:type="auto" /><w:tblLook w:val="01E0" /></w:tblPr><w:tblGrid><w:gridCol w:w="1548" /><w:gridCol w:w="3600" /><w:gridCol w:w="3374" /></w:tblGrid><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /><w:shd w:val="clear" w:color="auto" w:fill="000000" /></w:tcPr><w:p><w:pPr><w:bidi w:val="off" /><w:rPr><w:color w:val="FFFFFF" /></w:rPr></w:pPr><w:r><w:rPr><w:color w:val="FFFFFF" /></w:rPr><w:t>Question ID</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /><w:shd w:val="clear" w:color="auto" w:fill="000000" /></w:tcPr><w:p><w:pPr><w:bidi w:val="off" /><w:rPr><w:color w:val="FFFFFF" /></w:rPr></w:pPr><w:r><w:rPr><w:color w:val="FFFFFF" /></w:rPr><w:t>Question</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /><w:shd w:val="clear" w:color="auto" w:fill="000000" /></w:tcPr><w:p><w:pPr><w:bidi w:val="off" /><w:rPr><w:color w:val="FFFFFF" /></w:rPr></w:pPr><w:r><w:rPr><w:color w:val="FFFFFF" /></w:rPr><w:t>Answer</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>555</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">Now I want you to imagine that I'm a relation of yours who lives far away in Nigeria, and I have come to visit you in this area where you live. Because I don't come from this area, I want to ask you some questions about people who live here.</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t /></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>556</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">I have questions about how the people in this area behave, and how they think. I don't want you to tell me any names, I only want to know what people for this area think about corruption and do about corruption.</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t /></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>557</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">Please look at these pictures here. Let me give you an example of how you can use these pictures. Say I ask you how many people in this area think football is the best sport. On the left side, you see there are few people. You can point to this picture if you think few people in your area think football is the best sport. I do not mean that only two people think this, I just use the picture to show that a small number of people think this.</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t /></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>558</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">The next picture shows more people. You can point to this picture when you think that some people in your area think football is the best sport.</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t /></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>559</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">The next picture shows even more people. You can point to this picture if you think that plenty of people in this area think that football is the best sport.</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t /></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>560</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">Now see this picture on the end--there are many people! You can point to this picture if you think that almost everybody in this area thinks that football is the best sport. Do you understand?</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t /></w:r></w:p></w:tc></w:tr></w:tbl><w:p /><w:p><w:r><w:rPr><w:b /><w:b-cs /><w:sz w:val="24" /><w:sz-cs w:val="24" /></w:rPr><w:t xml:space="preserve">Sub-chapter: 5 questions rotation </w:t></w:r></w:p><w:p /><w:tbl><w:tblPr><w:tblStyle w:val="TableGrid" /><w:tblW w:w="0" w:type="auto" /><w:tblLook w:val="01E0" /></w:tblPr><w:tblGrid><w:gridCol w:w="1548" /><w:gridCol w:w="3600" /><w:gridCol w:w="3374" /></w:tblGrid><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /><w:shd w:val="clear" w:color="auto" w:fill="000000" /></w:tcPr><w:p><w:pPr><w:bidi w:val="off" /><w:rPr><w:color w:val="FFFFFF" /></w:rPr></w:pPr><w:r><w:rPr><w:color w:val="FFFFFF" /></w:rPr><w:t>Question ID</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /><w:shd w:val="clear" w:color="auto" w:fill="000000" /></w:tcPr><w:p><w:pPr><w:bidi w:val="off" /><w:rPr><w:color w:val="FFFFFF" /></w:rPr></w:pPr><w:r><w:rPr><w:color w:val="FFFFFF" /></w:rPr><w:t>Question</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /><w:shd w:val="clear" w:color="auto" w:fill="000000" /></w:tcPr><w:p><w:pPr><w:bidi w:val="off" /><w:rPr><w:color w:val="FFFFFF" /></w:rPr></w:pPr><w:r><w:rPr><w:color w:val="FFFFFF" /></w:rPr><w:t>Answer</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>561</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">How many people in this area think that government workers are corrupt?</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>Few people think that government workers are corrupt</w:t></w:r></w:p><w:p><w:r><w:t>Some people</w:t></w:r></w:p><w:p><w:r><w:t>Plenty of people</w:t></w:r></w:p><w:p><w:r><w:t>Almost everybody thinks that government workers are corrupt</w:t></w:r></w:p><w:p><w:r><w:t>I don't know [DO NOT READ]</w:t></w:r></w:p><w:p><w:r><w:t>Refused  [DO NOT READ]</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>562</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">How many people in this area think that police are corrupt?</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>Few people think that police are corrupt</w:t></w:r></w:p><w:p><w:r><w:t>Some people</w:t></w:r></w:p><w:p><w:r><w:t>Plenty of people</w:t></w:r></w:p><w:p><w:r><w:t>Almost everybody thinks that police are corrupt</w:t></w:r></w:p><w:p><w:r><w:t>I don't know [DO NOT READ]</w:t></w:r></w:p><w:p><w:r><w:t>Refused  [DO NOT READ]</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>563</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">How many people in this area think that the government is corrupt?</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>Few people think that the government is corrupt</w:t></w:r></w:p><w:p><w:r><w:t>Some people</w:t></w:r></w:p><w:p><w:r><w:t>Plenty of people</w:t></w:r></w:p><w:p><w:r><w:t>Almost everybody thinks that the government is corrupt</w:t></w:r></w:p><w:p><w:r><w:t>I don't know [DO NOT READ]</w:t></w:r></w:p><w:p><w:r><w:t>Refused  [DO NOT READ]</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>564</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">How many people in this area think that there is a lot of corruption in this area?</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>Few people think there is a lot of corruption in this area</w:t></w:r></w:p><w:p><w:r><w:t>Some people</w:t></w:r></w:p><w:p><w:r><w:t>Plenty of people</w:t></w:r></w:p><w:p><w:r><w:t>Almost everybody thinks there is a lot of corruption in this area</w:t></w:r></w:p><w:p><w:r><w:t>I don't know [DO NOT READ]</w:t></w:r></w:p><w:p><w:r><w:t>Refused  [DO NOT READ]</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>565</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">How many of the people in this area report corruption when they see it?</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>Few people report corruption</w:t></w:r></w:p><w:p><w:r><w:t>Some people</w:t></w:r></w:p><w:p><w:r><w:t>Plenty of people</w:t></w:r></w:p><w:p><w:r><w:t>Almost everybody reports corruption</w:t></w:r></w:p><w:p><w:r><w:t>I don't know [DO NOT READ]</w:t></w:r></w:p><w:p><w:r><w:t>Refused  [DO NOT READ]</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p /><w:p><w:r><w:rPr><w:b /><w:b-cs /><w:sz w:val="24" /><w:sz-cs w:val="24" /></w:rPr><w:t xml:space="preserve">Question not part of the previous rotation </w:t></w:r></w:p><w:p /><w:tbl><w:tblPr><w:tblStyle w:val="TableGrid" /><w:tblW w:w="0" w:type="auto" /><w:tblLook w:val="01E0" /></w:tblPr><w:tblGrid><w:gridCol w:w="1548" /><w:gridCol w:w="3600" /><w:gridCol w:w="3374" /></w:tblGrid><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /><w:shd w:val="clear" w:color="auto" w:fill="000000" /></w:tcPr><w:p><w:pPr><w:bidi w:val="off" /><w:rPr><w:color w:val="FFFFFF" /></w:rPr></w:pPr><w:r><w:rPr><w:color w:val="FFFFFF" /></w:rPr><w:t>Question ID</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /><w:shd w:val="clear" w:color="auto" w:fill="000000" /></w:tcPr><w:p><w:pPr><w:bidi w:val="off" /><w:rPr><w:color w:val="FFFFFF" /></w:rPr></w:pPr><w:r><w:rPr><w:color w:val="FFFFFF" /></w:rPr><w:t>Question</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /><w:shd w:val="clear" w:color="auto" w:fill="000000" /></w:tcPr><w:p><w:pPr><w:bidi w:val="off" /><w:rPr><w:color w:val="FFFFFF" /></w:rPr></w:pPr><w:r><w:rPr><w:color w:val="FFFFFF" /></w:rPr><w:t>Answer</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>566</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">How often do you hear people in this area talk about corruption issues?</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>Daily (3 times or more per week)</w:t></w:r></w:p><w:p><w:r><w:t>Weekly (1-2 times per week)</w:t></w:r></w:p><w:p><w:r><w:t>Monthly</w:t></w:r></w:p><w:p><w:r><w:t>Yearly</w:t></w:r></w:p><w:p><w:r><w:t>Never</w:t></w:r></w:p><w:p><w:r><w:t>I don't know [DO NOT READ]</w:t></w:r></w:p><w:p><w:r><w:t>Refused [DO NOT READ]</w:t></w:r></w:p></w:tc></w:t
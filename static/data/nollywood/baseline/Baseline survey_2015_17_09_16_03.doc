 people you know best.</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t /></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>658</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">Can you think of two people like this?</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>Yes, you can think of two people</w:t></w:r></w:p><w:p><w:r><w:t>No, you can only think of one person</w:t></w:r></w:p><w:p><w:r><w:t>No, you can't think of anyone who watched the film with you</w:t></w:r></w:p><w:p><w:r><w:t>Refused [DO NOT READ]</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>659</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">For the first person, what is their age?</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t /></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>660</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve" /></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>I don't know [DO NOT READ]</w:t></w:r></w:p><w:p><w:r><w:t>Refused [DO NOT READ]</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="1548" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>661</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa" /></w:tcPr><w:p><w:r><w:t xml:space="preserve">Are they male or female?</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3374" w:type="dxa" /></w:tcPr><w:p><w:r><w:t>Male</w:t></w:r></w:p><w:p><w:r><w:t>Female</w:t></w:r></w:p><w:p><w:r><w:t>I don't know [DO NOT READ]</w:t></w:r></w:p><w:p><w:r><w:t>Refused [DO NOT READ]</w:t></w
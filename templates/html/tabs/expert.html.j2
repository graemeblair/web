              <div class="row d-flex justify-content-center">
                <div class="col-12 col-lg-8">
                  <h1>Expert work</h1>
                  <p>{{ expert.intro }}</p>
{% for group in expert.groups %}
{% set cases = expert.cases | for_target | selectattr('group', 'equalto', group.id) | list | by_latest_stage_desc %}
{% if cases %}
                  <h2>{{ group.heading }}</h2>
{% if group.get('note') %}
                  <p><i>{{ group.note | markup }}</i></p>
{% endif %}
                  <ul class="case-list">
{% for case in cases %}
                    <li>
                      <p class="case-name">{{ case.case }}</p>
                      <div class="case-stages">
{% set ns = namespace(prev_court='') %}
{% for stage in case.stages | by_date_asc %}
                        <div class="case-stage">
                          <p class="stage-court">{% if stage.get('court') and stage.court != ns.prev_court %}{{ stage.court }} &middot; {% endif %}{{ stage.date | month_year }}{% if stage.get('caption') %} &middot; as {{ stage.caption }}{% endif %}</p>
{% if stage.get('court') %}{% set ns.prev_court = stage.court %}{% endif %}
                          <p class="stage-detail">{{ expert.roles[stage.role].site }}{% if stage.get('with') %} (with {{ stage['with'] | authors }}){% endif %}{% if stage.get('documents') %} &mdash; {% for doc in stage.documents %}<a href="{{ doc.url }}">{{ doc.label }}</a>{% if not loop.last %} &middot; {% endif %}{% endfor %}{% endif %}</p>
                        </div>
{% endfor %}
                      </div>
                    </li>
{% endfor %}
                  </ul>
{% endif %}
{% endfor %}
                </div>
              </div>
              <!-- row -->

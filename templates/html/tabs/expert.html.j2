              <div class="row d-flex justify-content-center">
                <div class="col-12 col-lg-8">
                  <h1>Expert work</h1>
                  <p>{{ expert.intro }}</p>
{% for group in expert.groups %}
{% set cases = expert.cases | for_target | selectattr('group', 'equalto', group.id) | list | by_latest_stage_desc %}
{% if cases %}
                  <h2>{{ group.heading }}</h2>
{% if group.get('note') %}
                  <p><i>{{ group.note | markup }}</i></p>
{% endif %}
                  <ul class="case-list">
{% for case in cases %}
                    <li>
                      <p class="case-name">{{ case.case }}</p>
                      <div class="case-stages">
{% for run in case.stages | by_date_asc | court_runs %}
{% if run.stages | length > 1 %}
                        <div class="case-stage">
                          <p class="stage-court">{{ run.court }}</p>
                          <ul class="stage-motions">
{% for stage in run.stages %}
                            <li>{{ expert.roles[stage.role] }} &middot; {{ stage.date | month_year }}{% if stage.get('caption') %} &middot; as {{ stage.caption }}{% endif %}{% if stage.get('with') %} (with {{ stage['with'] | authors }}){% endif %}{% if stage.get('documents') %} &mdash; {% for doc in stage.documents %}<a href="{{ doc.url }}">{{ doc.label }}</a>{% if not loop.last %} &middot; {% endif %}{% endfor %}{% endif %}</li>
{% endfor %}
                          </ul>
                        </div>
{% else %}
{% set stage = run.stages[0] %}
                        <div class="case-stage">
                          <p class="stage-court">{{ stage.court }} &middot; {{ stage.date | month_year }}{% if stage.get('caption') %} &middot; as {{ stage.caption }}{% endif %}</p>
                          <p class="stage-detail">{{ expert.roles[stage.role] }}{% if stage.get('with') %} (with {{ stage['with'] | authors }}){% endif %}{% if stage.get('documents') %} &mdash; {% for doc in stage.documents %}<a href="{{ doc.url }}">{{ doc.label }}</a>{% if not loop.last %} &middot; {% endif %}{% endfor %}{% endif %}</p>
                        </div>
{% endif %}
{% endfor %}
                      </div>
                    </li>
{% endfor %}
                  </ul>
{% endif %}
{% endfor %}
                </div>
              </div>
              <!-- row -->

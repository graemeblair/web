{% from 'macros/paper.html.j2' import paper %}
{% set pubs = publications.publications | for_target %}
              <div class="row gx-5">
{% for col in publications.columns %}
                <div class="col-md-6">
                  <h1>{{ col.heading }}</h1>
{% if col.get('award') %}
                  <p class="paper-links"><a href="{{ col.award.url }}"><i class="{{ site.link_icons.Trophy }}"></i>{{ col.award.text }}</a></p>
{% endif %}
{# The site has two headings, the CV distinguishes four kinds. "Articles" here
   means everything that is not the book -- the chapter in Druckman and Green
   sits under it, as it did in the hand-written page. Testing `kind == 'article'`
   instead dropped that entry from the site entirely. #}
{% for kind, label in [('book', 'Book'), ('article', 'Articles')] %}
{% set in_column = pubs | selectattr('column', 'equalto', col.id) | list %}
{% set group = (in_column | selectattr('kind', 'equalto', 'book') | list) if kind == 'book'
               else (in_column | rejectattr('kind', 'equalto', 'book') | list) %}
{% if group %}
                  <p class="fs-18p fw-bolder"{% if kind == 'article' %} style="clear: both; padding-top: 20px;"{% endif %}>{{ label }}</p>
{% for pub in group %}
{% if pub.get('cover') %}
                  <p><a href="{{ pub.cover_url }}"><img src="{{ pub.cover }}" style="border: 1px solid #555;margin-right:25px;float:left;width:100px;height:142.83333px; filter: drop-shadow(3px 3px 0px #d3d3d3);"></a></p>
{% endif %}
{{ paper(pub, site.link_icons) }}
{% endfor %}
{% endif %}
{% endfor %}
                </div>
{% endfor %}
              </div>
              <!-- end row -->
